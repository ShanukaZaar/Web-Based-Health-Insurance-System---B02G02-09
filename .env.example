# ==========================================
# Root Environment Variables Configuration
# Copy this file to .env in local environments
# DO NOT COMMIT REAL SECRETS OR CREDENTIALS
# ==========================================

# Database Configuration (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=health_insurance_db
DB_USERNAME=root
DB_PASSWORD=your_password_here
DB_URL=jdbc:mysql://localhost:3306/health_insurance_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# Spring Boot Backend Server Configuration
SERVER_PORT=8080

# Frontend Configuration (React + Vite)
VITE_API_BASE_URL=http://localhost:8080/api
